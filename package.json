{
  "name": "@aiostreams/release-parser",
  "version": "1.0.0",
  "description": "A TypeScript library for parsing torrent titles",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "pnpm build",
    "format": "prettier --write ./src/**/*.ts ./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AIOStreams/release-parser.git"
  },
  "bugs": {
    "url": "https://github.com/AIOStreams/release-parser/issues"
  },
  "homepage": "https://github.com/AIOStreams/release-parser#readme",
  "keywords": [
    "torrent",
    "parser",
    "title",
    "typescript",
    "esm"
  ],
  "author": "Viren070",
  "license": "MIT",
  "packageManager": "pnpm@11.0.8+sha512.4c4097e1dd2d42372c4e7fa5a791ff28fc75a484c7ac192e64b1df0fdef17594ba982f9b4fed9adfb3c757846f565b799b2763fb3733d1de1bcb82cf46684912",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "typescript": "^5.3.0"
  }
}
